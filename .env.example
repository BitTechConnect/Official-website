# BIT TECH CONNECT — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your real credentials.
# NEVER commit .env or expose service-role keys in frontend code.

# Server Port (must be 3000 in AI Studio preview)
PORT=3000

# Public Application URL (for SEO sitemap, canonical links, and CORS)
APP_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000"

# Supabase Configuration (PostgreSQL + Auth + Storage)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="bit-tech-media"

# Single Authorized Admin Account Email (must match the single Supabase Auth user)
ADMIN_EMAIL=""

# Optional HMAC secret for signing server-side admin session cookies
SESSION_SECRET=""
